# ZERO-API-FEE LOCAL MODE (recommended)
# Install Ollama, then run: ollama pull deepseek-r1:8b
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=deepseek-r1:8b

# Optional cloud mode (may incur provider charges): replace the three LLM_* values.
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=your_deepseek_api_key
# LLM_MODEL=deepseek-chat

# GitHub read access. Use a fine-grained token limited to the 11 repositories.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# Writes are disabled by default. Enable only after reviewing the repository allowlist.
GITHUB_WRITE_ENABLED=false
GITHUB_ALLOWED_REPOS=senthilsrinivasanmuthaiyan/clinic,senthilsrinivasanmuthaiyan/school,senthilsrinivasanmuthaiyan/jewel-pos,senthilsrinivasanmuthaiyan/universal-pos,senthilsrinivasanmuthaiyan/manufacturing,senthilsrinivasanmuthaiyan/chitfund,senthilsrinivasanmuthaiyan/onepass,senthilsrinivasanmuthaiyan/sassadmin,senthilsrinivasanmuthaiyan1/travel,senthilsrinivasanmuthaiyan1/transport-fleet,senthilsrinivasanmuthaiyan1/retail

DATABASE_PATH=./data/superagent.db
APP_HOST=127.0.0.1
APP_PORT=8787
MAX_PARALLEL_REPOS=4
